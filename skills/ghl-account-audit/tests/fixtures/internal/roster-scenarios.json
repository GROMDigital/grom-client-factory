{
  "note": "list_workflows_complete ledgers. ANTI-ORACLE RULE: reportedTotal, uniqueCount, uniqueProgress, totalHistory, pagination.* and terminalReason are INDEPENDENT literal inputs. Nothing here is derived from `workflows` at fixture-build or harness-build time, so a declared total is free to disagree with the rows actually served. Scenarios whose name starts with `liar-` declare complete:true while contradicting themselves; the adapter must catch them from the ledger alone. Source shape: core/audit-configuration.mjs finalize() (17 keys, NO contractVersion).",

  "one-page": {
    "expect": "complete",
    "workflows": [
      { "id": "WF1", "name": "01 Meta Lead Intake", "status": "published", "version": 4 },
      { "id": "WF2", "name": "02 Nurture", "status": "published", "version": 2 }
    ],
    "reportedTotal": 2,
    "uniqueCount": 2,
    "uniqueProgress": [2],
    "totalHistory": [2],
    "pagination": { "attempted": 1, "fetched": 1, "exhausted": false, "budget": 100 },
    "terminalReason": "unique_count_equals_reported_total",
    "complete": true,
    "warnings": []
  },

  "three-page": {
    "expect": "complete",
    "workflows": [
      { "id": "WF1", "name": "01 Meta Lead Intake", "status": "published", "version": 4 },
      { "id": "WF2", "name": "02 Nurture", "status": "published", "version": 2 },
      { "id": "WF3", "name": "03 No Show", "status": "published", "version": 1 },
      { "id": "WF4", "name": "04 Reactivation", "status": "draft", "version": 1 },
      { "id": "WF5", "name": "05 Internal Ops", "status": "published", "version": 7 }
    ],
    "reportedTotal": 5,
    "uniqueCount": 5,
    "uniqueProgress": [2, 2, 1],
    "totalHistory": [5, 5, 5],
    "pagination": { "attempted": 3, "fetched": 3, "exhausted": false, "budget": 100 },
    "terminalReason": "unique_count_equals_reported_total",
    "complete": true,
    "warnings": []
  },

