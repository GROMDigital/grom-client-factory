{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "universeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subjectRef": {
            "type": "string",
            "minLength": 1
          },
          "stratum": {
            "type": "string",
            "minLength": 1
          },
          "inclusionProbability": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scores": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "subjectRef",
          "stratum",
          "inclusionProbability",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "seed",
    "universeCount",
    "selections"
  ],
  "additionalProperties": false
}
