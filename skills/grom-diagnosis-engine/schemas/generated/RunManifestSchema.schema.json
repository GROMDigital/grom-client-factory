{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "targetKind": {
          "type": "string",
          "const": "location"
        },
        "operatingProfile": {
          "type": "string",
          "enum": [
            "client",
            "grom_internal"
          ]
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "companyId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "targetKind",
        "operatingProfile",
        "locationId"
      ],
      "additionalProperties": false
    },
    "profileId": {
      "type": "string",
      "enum": [
        "client",
        "grom_internal"
      ]
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "checkpointed",
        "complete_partial",
        "complete_full",
        "quarantined"
      ]
    },
    "coverageProfileHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "metricContractsHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "publicCatalogSnapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "target",
    "profileId",
    "startedAt",
    "status",
    "coverageProfileHash",
    "metricContractsHash",
    "publicCatalogSnapshotHash"
  ],
  "additionalProperties": false
}
