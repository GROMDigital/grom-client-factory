{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "exhaustionPolicy": {
      "type": "string",
      "const": "checkpoint_scope_incomplete"
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "maximumPages": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maximumRecords": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "maximumResponseBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "requestTimeoutMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "retryCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maximumTotalRetryDelayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "wallClockMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "maximumPages",
          "maximumRecords",
          "maximumResponseBytes",
          "requestTimeoutMs",
          "retryCount",
          "maximumTotalRetryDelayMs",
          "wallClockMs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "exhaustionPolicy",
    "capabilities"
  ],
  "additionalProperties": false
}
