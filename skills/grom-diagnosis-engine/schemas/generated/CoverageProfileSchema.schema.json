{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileId": {
      "type": "string",
      "enum": [
        "client",
        "grom_internal"
      ]
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "targetKind": {
      "type": "string",
      "const": "location"
    },
    "excludedCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "journeys": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "journeyId": {
            "type": "string",
            "minLength": 1
          },
          "journeyInstanceId": {
            "type": "string",
            "pattern": "^journey_[a-z][a-z0-9_]{2,127}$"
          },
          "entryRule": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": "string",
            "minLength": 1
          },
          "outcomes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "journeyId",
          "journeyInstanceId",
          "entryRule",
          "denominator",
          "outcomes"
        ],
        "additionalProperties": false
      }
    },
    "situation": {
      "type": "object",
      "properties": {
        "accountName": {
          "type": "string",
          "minLength": 1
        },
        "whoThisIs": {
          "type": "string",
          "minLength": 1
        },
        "howLeadsArrive": {
          "type": "string",
          "minLength": 1
        },
        "whatIsSold": {
          "type": "string",
          "minLength": 1
        },
        "theFunnel": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "knownDataCaveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edgeId": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "standard": {
                "type": "string",
                "enum": [
                  "industry_typical",
                  "industry_good",
                  "owner_decision"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "edgeId",
              "target",
              "standard",
              "basis"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "whoThisIs",
        "howLeadsArrive",
        "whatIsSold",
        "theFunnel",
        "objective",
        "knownDataCaveats"
      ],
      "additionalProperties": false
    },
    "questionEdges": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "edgeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "question",
          "edgeIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profileId",
    "version",
    "targetKind",
    "excludedCapabilities",
    "journeys"
  ],
  "additionalProperties": false
}
